{
  "name": "crown-season",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "The Crown Season — a mobile companion for the Crown Season men's group",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "parse": "node scripts/parse-curriculum.mjs",
    "parse:leader": "node scripts/parse-leader.mjs && node scripts/make-leader-seed.mjs",
    "seed:leader": "node scripts/make-leader-seed.mjs",
    "db:new": "supabase migration new",
    "db:push": "set -a; . ./.supabase.env; set +a; supabase db push --db-url \"$SUPABASE_DB_URL\"",
    "db:status": "set -a; . ./.supabase.env; set +a; supabase migration list --db-url \"$SUPABASE_DB_URL\"",
    "icons": "node scripts/make-icons.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.110.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2"
  },
  "devDependencies": {
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.2",
    "node-html-parser": "^6.1.13",
    "sharp": "^0.35.3",
    "typescript": "^5.6.3",
    "vite": "^5.4.9",
    "vite-plugin-pwa": "^0.20.5"
  }
}
